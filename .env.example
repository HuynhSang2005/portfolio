# Public (safe to expose to the browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Server-only — never expose to the client or commit real values
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional direct Postgres URL (local tooling / migrations)
# DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.your-project.supabase.co:5432/postgres

# Contact (P4) — for `bun run next` / `.env.local`. Workers preview also reads `.dev.vars`.
# Cloudflare Turnstile ALWAYS-PASS test keys (local only). Real keys from Turnstile dashboard;
# production secrets via `wrangler secret`.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
# Resend — local/dev can use onboarding@resend.dev; never commit a real API key.
RESEND_API_KEY=re_xxxxxxxxxxxx
CONTACT_TO_EMAIL=you@example.com
