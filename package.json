{
  "name": "portfolio",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "prebuild": "bun run scripts/bundle-mdx-content.ts",
    "build": "next build --webpack",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint .",
    "lint:fix": "oxlint . --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "test": "vitest",
    "test:run": "bun run prebuild && vitest run",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "check": "bun run typecheck && bun run lint && bun run format:check && bun run test:run",
    "validate": "bun run check && bun run build",
    "preview": "opennextjs-cloudflare build && node ./node_modules/@opennextjs/cloudflare/dist/cli/index.js preview",
    "deploy": "opennextjs-cloudflare build && node ./node_modules/@opennextjs/cloudflare/dist/cli/index.js deploy",
    "upload": "opennextjs-cloudflare build && node ./node_modules/@opennextjs/cloudflare/dist/cli/index.js upload",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@hookform/resolvers": "^5.5.7",
    "@marsidev/react-turnstile": "^1.5.4",
    "@opennextjs/cloudflare": "^1.20.2",
    "@supabase/ssr": "^0.12.3",
    "@supabase/supabase-js": "^2.110.8",
    "@tailwindcss/typography": "^0.5.20",
    "@tanstack/react-query": "^5.101.4",
    "@wrksz/themes": "^1.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "lucide-react": "^1.27.0",
    "motion": "^12.42.2",
    "next": "16.2.12",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.83.0",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "resend": "^6.18.1",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "vaul-base": "^1.0.0",
    "yaml": "^2.9.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.4",
    "hast-util-to-html": "^9.0.5",
    "jsdom": "^30.0.0",
    "oxfmt": "^0.60.0",
    "oxlint": "^1.75.0",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "shadcn": "^4.16.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "unified": "^11.0.5",
    "vitest": "^4.1.10",
    "wrangler": "^4.114.0"
  },
  "packageManager": "bun@1.3.14",
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ]
}
