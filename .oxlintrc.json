{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "react", "nextjs", "unicorn", "oxc"],
  "categories": {
    "correctness": "error"
  },
  "rules": {},
  "env": {
    "builtin": true
  },
  "ignorePatterns": [
    ".next/**",
    ".open-next/**",
    ".wrangler/**",
    "node_modules/**",
    "out/**",
    "dist/**",
    "coverage/**",
    "playwright-report/**",
    "test-results/**",
    "public/**",
    ".cursor/**",
    ".agents/**",
    ".impeccable/**",
    ".playwright/**",
    "portfolio-template-ui-ux/**",
    "supabase/.temp/**",
    "supabase/.branches/**"
  ]
}
